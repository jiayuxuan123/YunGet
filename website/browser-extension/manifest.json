{
  "manifest_version": 3,
  "name": "云取链接助手",
  "version": "2.1.0",
  "description": "自动拦截浏览器下载并交给云取 PC 满速下载，支持网络流媒体嗅探（HLS/DASH/视频）与页面直链/磁力/网盘链接主动扫描。",
  "permissions": [
    "tabs",
    "storage",
    "downloads",
    "cookies",
    "webRequest",
    "scripting",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "云取链接助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
