<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 实时更新（OPPO ColorOS 的「流体云」按此规范接入）：把下载进度提升为「进行中」通知。
         缺这条时进度通知仍能显示，但不会进入状态栏的实时进度区域。 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 锁屏保持下载：息屏时维持 Wi-Fi/CPU，避免长时间下载断连 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 锁屏保持下载：允许引导用户将应用加入「忽略电池优化」白名单 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- APK 安装：Android 8+ 检查「安装未知来源应用」权限需要 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 9- 写公共 Download 目录需要（10 走 MediaStore，legacy 模式回退也需要） -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- 内置下载引擎（Gopeed）只能按真实文件系统路径写文件：Android 11+ 要写公共 Download 目录
         就得有「所有文件访问」。低版本不需要（9- 用上面的 WRITE_EXTERNAL_STORAGE，
         10 由 application 的 requestLegacyExternalStorage 回到旧模式 + 同一运行时权限）。
         用户需在系统设置里手动开启；不给也能用 —— 引擎会自动退到应用外部私有目录。 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".YunGetApp"
        android:allowBackup="false"
        android:icon="@drawable/icon_dl"
        android:label="@string/app_name"
        android:roundIcon="@drawable/icon_dl"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.ComposeEmptyActivity">

        <!-- 默认桌面图标 = 新绘制的多线程下载图标（icon_dl，本二次开发版默认标识） -->
        <!-- launchMode=singleTask：从浏览器点网盘链接时把 intent 交给**已有实例**
             （走 onNewIntent），而不是再开一个。没有它，用户每点一个链接都会
             多一个任务栈里的实例，返回键要按很多次才能退出去。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ComposeEmptyActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 图标变体 1：经典图标（上游原项目风格，icon）；默认禁用，主题与外观页切换后启用 -->
        <activity-alias
            android:name=".MainActivityIcon1"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/icon"
            android:roundIcon="@drawable/icon"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 图标变体 2：云 X 图标（icon2）；默认禁用，主题与外观页切换后启用 -->
        <activity-alias
            android:name=".MainActivityIcon2"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/icon2"
            android:roundIcon="@drawable/icon2"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 崩溃界面：独立进程运行，避免主线程崩溃后无法展示 UI -->
        <activity
            android:name=".crash.CrashActivity"
            android:exported="false"
            android:process=":crash"
            android:theme="@style/Theme.ComposeEmptyActivity" />

        <!-- 下载前台服务：下载中保持前台，避免后台限速/进程被杀 -->
        <service
            android:name=".data.download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 文件共享：导出日志等场景（ACTION_SEND 分享） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ==================== 链接唤起（深链接） ====================
             从浏览器/其它应用点云盘分享链接时，直接进入本应用的解析页。

             每个网盘一个 activity-alias（而不是一个 alias 挂多个 host）：
             这样系统「设置 → 默认打开」里能逐项开关，用户想只用某个网盘时不至于
             被整体接管。alias 名带 .link. 前缀，便于与图标变体区分。

             目标统一是 .MainActivity：MainActivity 在 onCreate/onNewIntent 里
             通过 DeepLinks.textFrom 取出链接并交给解析链路。 -->

        <!-- 夸克网盘 -->
        <activity-alias
            android:name=".link.QuarkLink"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pan.quark.cn" android:pathPrefix="/s/" />
            </intent-filter>
        </activity-alias>

        <!-- UC 网盘 -->
        <activity-alias
            android:name=".link.UcLink"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="drive.uc.cn" android:pathPrefix="/s/" />
            </intent-filter>
        </activity-alias>

        <!-- 迅雷网盘 -->
        <activity-alias
            android:name=".link.XunleiLink"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pan.xunlei.com" android:pathPrefix="/s/" />
            </intent-filter>
        </activity-alias>

        <!-- 百度网盘 -->
        <activity-alias
            android:name=".link.BaiduLink"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pan.baidu.com" android:pathPrefix="/s/" />
            </intent-filter>
        </activity-alias>

        <!-- 中国移动云盘 -->
        <activity-alias
            android:name=".link.C139Link"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="yun.139.com" android:pathPrefix="/shareweb/" />
            </intent-filter>
        </activity-alias>

        <!-- 123 云盘 -->
        <activity-alias
            android:name=".link.Pan123Link"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.123pan.com" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="www.123865.com" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="www.123pan.cn" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="share.123pan.cn" android:pathPrefix="/123pan/" />
                <data android:scheme="https" android:host="*.share.123pan.cn" android:pathPrefix="/123pan/" />
            </intent-filter>
        </activity-alias>

        <!-- 115 网盘 -->
        <activity-alias
            android:name=".link.Pan115Link"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="115.com" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="115cdn.com" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="115rc.com" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="115.com" android:pathPrefix="/sw" />
            </intent-filter>
        </activity-alias>

        <!-- 光鸭云盘 -->
        <activity-alias
            android:name=".link.GuangYaLouLink"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="guangya.com" android:pathPrefix="/s/" />
            </intent-filter>
        </activity-alias>

        <!-- 蓝奏云 -->
        <activity-alias
            android:name=".link.LanzouLink"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="lanzou.com" android:pathPrefix="/" />
            </intent-filter>
        </activity-alias>

        <!-- 蓝奏云优享版 -->
        <activity-alias
            android:name=".link.ILanzouLink"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="ilanzou.com" android:pathPrefix="/" />
            </intent-filter>
        </activity-alias>

        <!-- 云取 解析 -->
        <activity-alias
            android:name=".link.ResolveLink"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="yung" android:host="resolve" />
            </intent-filter>
        </activity-alias>

        <!-- 系统「分享」与「选中文本 → 云取」：把文本交给解析页。
             单独一个 alias，不带 host 过滤（任何文本都可能含链接/口令）。 -->
        <activity-alias
            android:name=".link.ShareText"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
